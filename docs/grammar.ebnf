(* Parser grammar. ISO-14977-style: {x} = 0..n, [x] = optional, (a|b) = choice.
   Semantic checking supports only the scalar subset described in language.md.
   Recognized pointer, array, struct, string, index and member syntax is not executable. *)
(* Source: strictly valid UTF-8 everywhere, including strings/comments.
   Logical order; RTL is a display concern. Identifier comparison is bytewise
   without Unicode normalization; the optional morphology layer cannot rewrite tokens. *)

(* ---------- lexical ---------- *)
letter     = "a".."z" | "A".."Z" | "_" | U+0620..U+064A | U+066E..U+06D3 | U+06FA..U+06FF ;
mark       = U+064B..U+065F | U+0670 ;                (* harakat, shadda, dagger alif *)
digit      = "0".."9" | U+0660..U+0669 | U+06F0..U+06F9 ;
hexdigit   = "0".."9" | "a".."f" | "A".."F" ;
ident      = letter { letter | digit | mark } ;       (* minus keywords *)
intLit     = digit { digit } | "0" ("x"|"X") hexdigit { hexdigit } ;
            (* 0x without hex digits => E_HEX. Overflow consumes the entire
               decimal/hex digit run and returns one E_OVF token. *)
strLit     = '"' { ? valid Unicode scalar except '"', '\\', LF or CR ? | "\\" ("n"|"t"|"r"|"0"|"\\"|'"') } '"' ;
comment    = "//" { ? valid Unicode scalar except LF or CR ? }
           | "/*" { ? valid Unicode scalar ? } "*/" ;  (* no nesting *)
space      = " " | TAB | CR | LF | U+200E | U+200F | U+061C ;
            (* CR, LF, CRLF are each one logical newline; columns count scalars. *)

keyword    = "إذا" | "وإلا" | "طالما" | "أرجع" | "متغير" | "ثابت" | "دالة" | "هيكل" ;
            (* if, else, while, return, variable, constant, function, struct *)
COMMA      = "," | U+060C ;
SEMI       = ";" | U+061B ;

(* ---------- syntax ---------- *)
program    = { decl } EOF ;
decl       = funcDecl | structDecl | varDecl | constDecl ;

funcDecl   = "دالة" ident "(" [ param { COMMA param } ] ")" [ "->" type ] block ;
param      = ident ":" type ;
structDecl = "هيكل" ident "{" { ident ":" type SEMI } "}" ;
varDecl    = "متغير" ident ":" type [ "=" expr ] SEMI ;
constDecl  = "ثابت" ident ":" type "=" expr SEMI ;

type       = ident                       (* صحيح=i64, بايت=u8, منطقي=bool, or struct name *)
           | "*" type                    (* pointer *)
           | "[" intLit "]" type ;       (* fixed array *)

block      = "{" { stmt } "}" ;
stmt       = varDecl | constDecl | ifStmt | whileStmt | returnStmt | block | simpleStmt ;
ifStmt     = "إذا" "(" expr ")" block [ "وإلا" ( ifStmt | block ) ] ;
whileStmt  = "طالما" "(" expr ")" block ;
returnStmt = "أرجع" [ expr ] SEMI ;
simpleStmt = expr [ "=" expr ] SEMI ;     (* lvalue check is semantic *)

expr       = orExpr ;
orExpr     = andExpr   { "||" andExpr } ;
andExpr    = bitOr     { "&&" bitOr } ;
bitOr      = bitXor    { "|"  bitXor } ;
bitXor     = bitAnd    { "^"  bitAnd } ;
bitAnd     = equality  { "&"  equality } ;
equality   = relation  { ("==" | "!=") relation } ;
relation   = shift     { ("<" | "<=" | ">" | ">=") shift } ;
shift      = additive  { ("<<" | ">>") additive } ;
additive   = term      { ("+" | "-") term } ;
term       = unary     { ("*" | "/" | "%") unary } ;
unary      = ("-" | "!" | "~" | "*" | "&") unary | postfix ;
postfix    = primary { "(" [ expr { COMMA expr } ] ")"   (* call syntax; semantic checking requires a function name *)
                     | "[" expr "]"
                     | "." ident } ;
primary    = intLit | strLit | ident | "(" expr ")" ;
