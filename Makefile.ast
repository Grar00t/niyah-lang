# GNU/Python tooling is build-time only; niyahc and generated ELF need no libc.
NIYAH_MODEL ?= ../niyah-assembly-model
AST_MODEL = $(abspath $(NIYAH_MODEL))
AST_BUILD = build/tensor_core
AST_FLAGS = -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror -ffreestanding -fno-builtin -fno-stack-protector -fno-pie -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-avx -mno-avx2
$(AST_BUILD)/tensor_templates.h: tools/gen_tensor_templates.py src/tensor_ir_bridge.s $(AST_MODEL)/src/tensor_runtime.s $(AST_MODEL)/src/tensor_dispatch.s $(AST_MODEL)/src/tile_allocator.s $(AST_MODEL)/build/tile_allocator niyahc-tile
	python3 tools/gen_tensor_templates.py . "$(AST_MODEL)"
$(AST_BUILD)/tensor_allocate.o: $(AST_BUILD)/tensor_templates.h
	as --64 -o $@ $(AST_BUILD)/tensor_allocate.s
niyahc: src/compile_cli.c src/codegen.c src/codegen.h $(FRONTEND) $(HEADERS) src/morph.c src/morph.h src/tensor_core.c src/tensor_core.h src/compiler_native.c src/compiler_start.s $(AST_BUILD)/tensor_templates.h $(AST_BUILD)/tensor_allocate.o
	$(CC) $(AST_FLAGS) -DNIYAH_TENSOR_CORE -I$(AST_BUILD) -nostdlib -static -no-pie -Wl,--build-id=none,-z,noexecstack -o $@ src/compiler_start.s src/compile_cli.c src/compiler_native.c src/codegen.c src/tensor_core.c src/morph.c $(FRONTEND) $(AST_BUILD)/tensor_allocate.o

.PHONY: test-ast-tensor
test-ast-tensor: niyahc niyahc-tile
	NIYAH_MODEL="$(AST_MODEL)" python3 tests/test_ast_tensor.py
test: test-ast-tensor

# A fresh companion checkout has no generated allocator binary.
$(AST_MODEL)/build/tile_allocator: $(AST_MODEL)/src/tile_allocator.s $(AST_MODEL)/Makefile.kernels
	$(MAKE) -C "$(AST_MODEL)" tile-allocator
